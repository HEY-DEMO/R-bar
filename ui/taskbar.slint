import { Theme, ThemePalette } from "theme.slint";

export { Theme, ThemePalette }

export struct PinnedData {
    title: string,
    initial: string,
    has_icon: bool,
    icon: image,
}

export struct TaskData {
    title: string,
    initial: string,
    app_id: string,
    window_count: int,
    has_multiple: bool,
    is_active: bool,
    is_minimized: bool,
}

component StartButton inherits Rectangle {
    callback clicked();
    in property <bool> is_vertical: false;

    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff22 : touch.has-hover ? #ffffff15 : #00000000;

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Windows 11 4-tile logo
    Rectangle {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Top-left
        Rectangle {
            x: 0px;
            y: 0px;
            width: 8px;
            height: 8px;
            border-radius: 1px;
            background: #0078d4;
        }
        // Top-right
        Rectangle {
            x: 10px;
            y: 0px;
            width: 8px;
            height: 8px;
            border-radius: 1px;
            background: #0078d4;
        }
        // Bottom-left
        Rectangle {
            x: 0px;
            y: 10px;
            width: 8px;
            height: 8px;
            border-radius: 1px;
            background: #0078d4;
        }
        // Bottom-right
        Rectangle {
            x: 10px;
            y: 10px;
            width: 8px;
            height: 8px;
            border-radius: 1px;
            background: #0078d4;
        }
    }

    if touch.has-hover : Rectangle {
        y: is_vertical ? 8px : -28px;
        x: is_vertical ? 46px : (parent.width - self.width) / 2;
        height: 22px;
        background: #202020f0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ffffff20;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Text {
                text: "Start";
                color: #ffffff;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}

component PinnedItemButton inherits Rectangle {
    in property <string> title;
    in property <string> initial;
    in property <bool> has_icon;
    in property <image> icon;
    in property <bool> is_vertical: false;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff22 : touch.has-hover ? #ffffff15 : #00000000;

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if has_icon : Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !has_icon : Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 4px;
        background: #2d2d2d;
        border-width: 1px;
        border-color: #ffffff18;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Text {
            text: root.initial;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if touch.has-hover && title != "" : Rectangle {
        y: is_vertical ? 8px : -28px;
        x: is_vertical ? 46px : (parent.width - self.width) / 2;
        height: 22px;
        background: #202020f0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ffffff20;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Text {
                text: title;
                color: #ffffff;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}

component TaskItemButton inherits Rectangle {
    in property <string> title;
    in property <string> initial;
    in property <int> window_count: 1;
    in property <bool> has_multiple: false;
    in property <bool> is_active: false;
    in property <bool> is_vertical: false;
    callback clicked();

    width: 44px;
    height: 40px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff25 : touch.has-hover ? #ffffff18 : (is_active ? #ffffff10 : #00000000);

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // App letter/initial badge
    Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 4px;
        background: #2a2a2a;
        border-width: 1px;
        border-color: #ffffff20;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Text {
            text: root.initial;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Multiple windows badge count
    if has_multiple : Rectangle {
        x: parent.width - 15px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #0078d4;
        Text {
            text: root.window_count;
            color: #ffffff;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Active indicator pill
    if is_active : Rectangle {
        x: is_vertical ? 0px : (parent.width - 16px) / 2;
        y: is_vertical ? (parent.height - 16px) / 2 : (parent.height - 3px);
        width: is_vertical ? 3px : 16px;
        height: is_vertical ? 16px : 3px;
        border-radius: 1.5px;
        background: #60cdff;
    }

    // Hover tooltip
    if touch.has-hover && title != "" : Rectangle {
        y: is_vertical ? 8px : -28px;
        x: is_vertical ? 48px : (parent.width - self.width) / 2;
        height: 22px;
        background: #202020f0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ffffff20;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Text {
                text: title;
                color: #ffffff;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}

component TrayToggleButton inherits Rectangle {
    callback clicked();
    in property <bool> is_vertical: false;

    width: 28px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff22 : touch.has-hover ? #ffffff15 : #00000000;

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: "^";
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component VolumeControl inherits Rectangle {
    in property <int> volume_percent: 50;
    in property <bool> is_vertical: false;
    callback volume_changed(float);

    property <bool> show_flyout: false;

    width: is_vertical ? 36px : 52px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff22 : touch.has-hover ? #ffffff15 : #00000000;

    animate background { duration: 120ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 2px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.volume_percent == 0 ? "🔇" : (root.volume_percent < 50 ? "🔉" : "🔊");
            font-size: 11px;
            vertical-alignment: center;
        }

        if !is_vertical : Text {
            text: "\{root.volume_percent}%";
            color: #e0e0e0;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.show_flyout = !root.show_flyout;
        }
    }

    // Volume Slider Flyout popup
    if root.show_flyout : Rectangle {
        y: is_vertical ? 0px : -75px;
        x: is_vertical ? 42px : -36px;
        width: 130px;
        height: 65px;
        background: #202020f5;
        border-radius: 6px;
        border-width: 1px;
        border-color: #ffffff25;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            alignment: center;

            Text {
                text: "Volume: \{root.volume_percent}%";
                color: #ffffff;
                font-size: 11px;
                horizontal-alignment: center;
            }

            // Slider track
            slider_box := Rectangle {
                height: 18px;
                width: 110px;

                // Track background
                Rectangle {
                    y: 7px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff33;
                }

                // Filled level
                Rectangle {
                    x: 0px;
                    y: 7px;
                    width: (parent.width * root.volume_percent) / 100;
                    height: 4px;
                    border-radius: 2px;
                    background: #0078d4;
                }

                // Thumb
                Rectangle {
                    x: ((parent.width - 12px) * root.volume_percent) / 100;
                    y: 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #ffffff;
                }

                TouchArea {
                    moved => {
                        if self.pressed {
                            let ratio = self.mouse-x / parent.width;
                            let clamped = Math.max(0.0, Math.min(1.0, ratio));
                            root.volume_changed(clamped * 100.0);
                        }
                    }
                    clicked => {
                        let ratio = self.mouse-x / parent.width;
                        let clamped = Math.max(0.0, Math.min(1.0, ratio));
                        root.volume_changed(clamped * 100.0);
                    }
                }
            }
        }
    }
}

component SystemStatusArea inherits Rectangle {
    in property <string> time_text: "12:00";
    in property <string> date_text: "2026-11-08";
    in property <string> battery_text: "";
    in property <int> volume_percent: 50;
    in property <bool> is_vertical: false;
    callback tray_toggle_clicked();
    callback volume_changed(float);

    HorizontalLayout {
        spacing: 6px;
        alignment: end;

        TrayToggleButton {
            is_vertical: root.is_vertical;
            clicked => { root.tray_toggle_clicked(); }
        }

        VolumeControl {
            volume_percent: root.volume_percent;
            is_vertical: root.is_vertical;
            volume_changed(vol) => { root.volume_changed(vol); }
        }

        if battery_text != "" : Rectangle {
            height: 32px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: root.battery_text;
                    color: #e0e0e0;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // Clock & Date stack
        Rectangle {
            height: 36px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.time_text;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.date_text;
                    color: #b0b0b0;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Taskbar";
    no-frame: true;
    always-on-top: true;
    default-font-size: 12px;
    height: 48px;

    in-out property <string> theme_name: "Glossy";
    in-out property <bool> is_vertical: false;
    in property <[PinnedData]> pinned_items: [];
    in property <[TaskData]> tasks: [];
    in property <string> time_text: "12:00";
    in property <string> date_text: "2026-11-08";
    in property <string> battery_text: "";
    in property <int> volume_percent: 50;

    callback start_clicked();
    callback pinned_clicked(int);
    callback task_clicked(int);
    callback tray_toggle_clicked();
    callback volume_changed(float);

    // Active palette derived from Theme global
    property <ThemePalette> current_palette: Theme.palette(theme_name);

    background: current_palette.background;

    Rectangle {
        border-width: current_palette.border-width;
        border-color: current_palette.border-color;
        border-radius: current_palette.corner-radius;

        if !is_vertical : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            alignment: space-between;

            // Left / Start & Pinned area
            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                StartButton {
                    is_vertical: false;
                    clicked => { root.start_clicked(); }
                }

                for item[idx] in root.pinned_items: PinnedItemButton {
                    title: item.title;
                    initial: item.initial;
                    has_icon: item.has_icon;
                    icon: item.icon;
                    is_vertical: false;
                    clicked => { root.pinned_clicked(idx); }
                }

                // Running tasks
                for item[idx] in root.tasks: TaskItemButton {
                    title: item.title;
                    initial: item.initial;
                    window_count: item.window_count;
                    has_multiple: item.has_multiple;
                    is_active: item.is_active;
                    is_vertical: false;
                    clicked => { root.task_clicked(idx); }
                }
            }

            // Right / System status area
            SystemStatusArea {
                time_text: root.time_text;
                date_text: root.date_text;
                battery_text: root.battery_text;
                volume_percent: root.volume_percent;
                is_vertical: false;
                tray_toggle_clicked => { root.tray_toggle_clicked(); }
                volume_changed(vol) => { root.volume_changed(vol); }
            }
        }

        if is_vertical : VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                StartButton {
                    is_vertical: true;
                    clicked => { root.start_clicked(); }
                }

                for item[idx] in root.pinned_items: PinnedItemButton {
                    title: item.title;
                    initial: item.initial;
                    has_icon: item.has_icon;
                    icon: item.icon;
                    is_vertical: true;
                    clicked => { root.pinned_clicked(idx); }
                }

                for item[idx] in root.tasks: TaskItemButton {
                    title: item.title;
                    initial: item.initial;
                    window_count: item.window_count;
                    has_multiple: item.has_multiple;
                    is_active: item.is_active;
                    is_vertical: true;
                    clicked => { root.task_clicked(idx); }
                }
            }

            VerticalLayout {
                alignment: end;
                spacing: 6px;

                TrayToggleButton {
                    is_vertical: true;
                    clicked => { root.tray_toggle_clicked(); }
                }

                VolumeControl {
                    volume_percent: root.volume_percent;
                    is_vertical: true;
                    volume_changed(vol) => { root.volume_changed(vol); }
                }

                Text {
                    text: root.time_text;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component TaskbarWindow inherits MainWindow {}
